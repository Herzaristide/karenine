/* Generated by paletted -- do not edit.
   Written directly to ~/.config/vesktop/settings/quickCss.css.
   Vencord watches this file (fs.watch on its inode) and re-injects it live:
   no reload needed when the accent or the dark/light mode changes.

   The palette is the active mode's, so every Discord theme class gets the
   same colours: Vesktop follows karenine whatever theme Discord is set to.
   `html` raises the specificity above Discord's own `.theme-*` blocks
   (including the later `@supports (color-mix)` ones). High-contrast mode
   and custom profile themes stay Discord's (higher specificity, on purpose).

   Surfaces mirror the GTK4 and Zed templates: content on base00, side
   panels and raised surfaces on base01, borders and selection on base02. */

html:is(.theme-dark, .theme-light, .theme-darker, .theme-midnight),
html :is(.theme-dark, .theme-light, .theme-darker, .theme-midnight) {
  color-scheme: @MODE@;

  /* -- Surfaces -- */
  --background-base-lowest:   @BASE00@;  /* server rail, title bar */
  --background-base-lower:    @BASE01@;  /* channel list */
  --background-base-low:      @BASE01@;  /* user panel, member list */
  --background-surface-high:    @BASE00@;
  --background-surface-higher:  @BASE01@;  /* popouts, menus */
  --background-surface-highest: @BASE02@;
  --bg-surface-raised:        @BASE01@;
  --chat-background-default:  @BASE00@;
  --chat-background:          @BASE00@;
  --channel-background-default: @BASE00@;
  --panel-bg:                 @BASE01@;
  --modal-background:         @BASE01@;
  --modal-footer-background:  @BASE00@;
  --card-background-default:  @BASE01@;
  --card-secondary-bg:        @BASE01@;
  --card-primary-pressed-bg:  @BASE02@;
  --card-secondary-pressed-bg: @BASE02@;
  --background-code:          @BASE01@;

  /* Legacy names, still read by older surfaces and Vencord's own UI. */
  --background-primary:       @BASE00@;
  --background-secondary:     @BASE01@;
  --background-secondary-alt: @BASE01@;
  --background-tertiary:      @BASE00@;
  --background-floating:      @BASE01@;

  /* Translucent overlays (hover, pressed) drawn over any surface. */
  --background-mod-muted:  rgba(@BASE05_RGB@, 0.04);
  --background-mod-subtle: rgba(@BASE05_RGB@, 0.06);
  --background-mod-normal: rgba(@BASE05_RGB@, 0.10);
  --background-mod-strong: rgba(@BASE05_RGB@, 0.16);
  --message-background-hover: rgba(@BASE05_RGB@, 0.04);

  /* -- Text -- */
  --text-strong:  @BASE07@;
  --text-default: @BASE05@;
  --text-subtle:  @BASE04@;
  --text-muted:   @BASE04@;
  --chat-text-muted: @BASE04@;
  --text-invert:  @BASE00@;
  --header-primary:   @BASE07@;
  --header-secondary: @BASE04@;
  --text-normal:      @BASE05@;
  --channels-default: @BASE04@;
  --channel-icon:     @BASE04@;
  --channel-text-area-placeholder: @BASE03@;
  --textbox-markdown-syntax: @BASE03@;

  /* -- Interactive (sidebar items, icons) -- */
  --interactive-text-default: @BASE04@;
  --interactive-text-hover:   @BASE05@;
  --interactive-text-active:  @BASE07@;
  --interactive-icon-default: @BASE04@;
  --interactive-icon-hover:   @BASE05@;
  --interactive-icon-active:  @BASE07@;
  --interactive-muted:        @BASE03@;
  --interactive-normal:       @BASE04@;
  --interactive-hover:        @BASE05@;
  --interactive-active:       @BASE07@;
  --interactive-background-hover:    rgba(@BASE05_RGB@, 0.06);
  --interactive-background-active:   @BASE02@;
  --interactive-background-selected: @BASE02@;

  /* -- Inputs -- */
  --input-background-default: @BASE01@;
  --input-border-default:     @BASE02@;
  --input-border-hover:       @BASE03@;
  --input-text-default:       @BASE05@;
  --input-placeholder-text-default: @BASE03@;
  --input-icon-default:       @BASE04@;
  --channeltextarea-background: @BASE01@;

  /* -- Borders -- */
  --border-muted:  @BASE02@;
  --border-subtle: @BASE02@;
  --border-normal: @BASE02@;
  --border-strong: @BASE03@;
  --chat-border:   @BASE02@;
  --card-border-default: @BASE02@;

  /* -- Scrollbars -- */
  --scrollbar-thin-thumb: @BASE02@;
  --scrollbar-thin-track: transparent;
  --scrollbar-auto-thumb: @BASE02@;
  --scrollbar-auto-track: transparent;
  --scrollbar-auto-scrollbar-color-thumb: @BASE02@;
  --scrollbar-auto-scrollbar-color-track: transparent;

  /* -- Status and feedback (the palette's muted state colours) -- */
  --text-feedback-critical: @BASE08@;
  --text-feedback-warning:  @BASE0A@;
  --text-feedback-positive: @BASE0B@;
  --text-feedback-info:     @BASE0E@;
  --text-status-online:  @BASE0B@;
  --text-status-idle:    @BASE0A@;
  --text-status-dnd:     @BASE08@;
  --text-status-offline: @BASE03@;

  /* -- Accent -- */
  --brand-experiment:     @ACCENT@;
  --brand-experiment-500: @ACCENT@;
  --brand-experiment-560: @ACCENT@;
  --brand-experiment-600: @ACCENT_DARK@;
  --brand-500: @ACCENT@;
  --brand-560: @ACCENT@;
  --brand-600: @ACCENT_DARK@;
  --background-brand: @ACCENT@;
  --background-accent: @ACCENT@;
  --interactive-accent-background-default:  @ACCENT@;
  --interactive-accent-background-hover:    @ACCENT_DARK@;
  --interactive-accent-background-active:   @ACCENT_DARK@;
  --interactive-accent-background-selected: @ACCENT_DARK@;
  --border-focus: @ACCENT@;
  --text-link: @ACCENT_MUTED@;
}

/* Call panel (DM calls, voice channels): Discord paints it var(--black) in
   every theme, outside the surface variables, on two layers: the container
   and the call view's root (the one holding the centre controls) on top of
   it. Video tiles stay black. */
[class*="callContainer_"],
[class*="callContainer_"] [class*="root_"]:has([class*="centerControls_"]) {
  background: @BASE01@ !important;
}

/* Friends panel: "Add Friend" tab + childWrapper buttons.
   Discord hardcodes #5865F2 on these, so we target the class. */
[class*="addFriend__"],
[class*="childWrapper__"],
[class*="childWrapperNoHoverBg__"] {
  background-color: @ACCENT@ !important;
  color: #ffffff !important;
}
[class*="addFriend__"]:hover,
[class*="childWrapper__"]:hover {
  background-color: @ACCENT_DARK@ !important;
}

/* Inline-style fallback: anything literally styled with Discord blurple. */
[style*="#5865F2"],
[style*="#5865f2"],
[style*="rgb(88, 101, 242)"] {
  background-color: @ACCENT@ !important;
  color: #ffffff !important;
}
